{
  "name": "boilerate-admin",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "prestart": "node scripts/runtime-config.mjs",
    "prebuild": "node scripts/runtime-config.mjs",
    "start": "ng serve --host 127.0.0.1 --port 4200",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "lint": "eslint src && npm run test:architecture",
    "format:check": "prettier --check src public scripts e2e docs .github playwright.config.ts angular.json tsconfig*.json package.json eslint.config.mjs vitest-base.config.mts",
    "check": "npm run format:check && npm run lint && npm run test && npm run build",
    "test:e2e": "playwright test --project=desktop-light --project=desktop-dark --project=tablet-light --project=tablet-dark",
    "test:e2e:mobile": "playwright test --project=mobile-light --project=mobile-dark",
    "test:e2e:all": "playwright test",
    "test:e2e:update": "npm run test:e2e -- --update-snapshots",
    "preview": "node scripts/serve-dist.mjs",
    "test:architecture": "node scripts/check-boundaries.mjs"
  },
  "packageManager": "npm@12.2.0",
  "dependencies": {
    "@angular/cdk": "22.2.3",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "@fontsource-variable/inter": "^5.2.8",
    "@primeuix/themes": "3.0.1",
    "primeng": "22.1.2",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.64.1",
    "angular-eslint": "22.6.0",
    "eslint": "^9.39.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^5.4.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.6.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "handlebars": "4.7.10"
  }
}
